# Findably MVP — Environment Variables Template
# Copy this file to .env.local and fill in the actual values
# Never commit .env.local to git — it contains sensitive information

# ============================================================================
# DATABASE & AUTHENTICATION (Supabase)
# ============================================================================

# Supabase API URL (공개, Next.js 클라이언트에서 사용)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (공개, 클라이언트 인증용)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role key (비밀, 서버 측에서만 사용)
# 이 키는 절대 클라이언트에 노출되어서는 안 됩니다.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL 데이터베이스 URL (Drizzle ORM, migrations)
# 형식: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/findably

# ============================================================================
# AI & EXTERNAL APIs
# ============================================================================

# Anthropic Claude API Key (콘텐츠 분석, 인사이트 생성)
ANTHROPIC_API_KEY=sk-ant-v7-...

# Google PageSpeed Insights API Key (성능 메트릭)
GOOGLE_PAGESPEED_API_KEY=AIzaSy...

# ============================================================================
# AUTOMATION & WEBHOOKS
# ============================================================================

# n8n Webhook URL (크롤링 트리거용, 공개)
N8N_WEBHOOK_URL=https://n8n.railway.app/webhook/findably-crawl

# n8n Webhook Base URL (health check용)
N8N_WEBHOOK_BASE_URL=https://n8n.railway.app

# ============================================================================
# APPLICATION
# ============================================================================

# Application URL (OAuth callback, email links 등)
# Development: http://localhost:3000
# Production: https://findably.com (또는 커스텀 도메인)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node 환경 (development, production)
NODE_ENV=development

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Sentry DSN (에러 추적)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=sntrys_...

# PostHog 분석 (사용자 행동 추적)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# ============================================================================
# NOTES
# ============================================================================

# 환경변수 로드 순서:
# 1. .env.local (개발/로컬, .gitignore로 제외)
# 2. .env.production (프로덕션, Vercel/Railway 사용)
# 3. Vercel Dashboard (프로덕션 배포 시 우선순위 최고)

# NEXT_PUBLIC_* 접두사: 클라이언트 번들에 포함됨 (보안상 민감 정보 금지)
# 다른 환경변수: 서버 측에서만 사용 가능 (안전함)

# Vercel 배포 시:
# - 모든 환경변수를 Vercel Dashboard → Settings → Environment Variables에서 설정
# - .env.local은 로컬 개발에만 사용
# - .env 파일을 git에 커밋하지 말 것 (.gitignore 확인)
