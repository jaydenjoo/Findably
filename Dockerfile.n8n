# Dockerfile for n8n deployment on Railway
# This file is used when deploying n8n separately from the main application

FROM n8nio/n8n:latest

# Set working directory
WORKDIR /home/node/.n8n

# Copy any local workflow definitions (optional)
# COPY ./n8n/workflows/ /workflows/

# Environment variables are set via Railway dashboard or docker-compose
# See .env.example for reference

# Expose port
EXPOSE 5678

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:5678/api/v1/health || exit 1

# Default command (n8n will start automatically)
CMD ["n8n", "start"]
